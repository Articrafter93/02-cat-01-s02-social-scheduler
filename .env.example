# === Programador de Redes Sociales — variables de entorno (ejemplo) ===
# Copiar a .env.local y rellenar con valores reales (NUNCA commitear .env.local).
# Los valores reales viven en Vercel env / Supabase; aquí solo van las claves.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # solo server-side (worker de cola, seed); nunca al cliente
SUPABASE_DB_SCHEMA=cat01s02_scheduler   # schema dedicado (regla schema-pooling ficticio)

# --- Cola / Cron ---
QUEUE_CRON_SECRET=                  # token que el GitHub Action envía a /api/queue/process
QUEUE_MAX_ATTEMPTS=5                # reintentos antes de DLQ
QUEUE_BACKOFF_BASE_SECONDS=60       # base del backoff exponencial

# --- Login mock (portafolio, NO productivo) ---
NEXT_PUBLIC_DEMO_MODE=true          # habilita el login mock; debe ser false/ausente en producción real
DEMO_PASSWORD=demo1234              # dato sandbox (excepción legítima); login bloqueado en prod

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
